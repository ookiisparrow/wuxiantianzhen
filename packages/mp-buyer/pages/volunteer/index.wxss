.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.title {
  font-weight: 700;
  font-size: 30rpx;
}
.pts {
  color: #d96b43;
  font-weight: 700;
}
.sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a746e;
}
.exam-btn {
  margin-top: 24rpx;
}
.rev-input {
  background: #f7f4f0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.photo-slots {
  margin: 20rpx 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.slot-pill {
  background: #faf6f2;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #5c534d;
}
.score-row {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0;
}
.score-chip {
  padding: 14rpx 24rpx;
  border-radius: 16rpx;
  background: #f3ede7;
  font-weight: 600;
}
.score-active {
  background: #d96b43;
  color: #ffffff;
}
.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.tag-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f6efe8;
  font-size: 24rpx;
  color: #6d5a50;
}
.vote-btn {
  margin-top: 12rpx;
}
