.pool-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #d96b43;
}
.pool-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a746e;
}
.sec-title {
  font-weight: 700;
  margin-bottom: 20rpx;
}
.yarn-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2ebe4;
}
.yarn-code {
  font-weight: 600;
  margin-right: 12rpx;
}
.yarn-sub {
  font-size: 24rpx;
  color: #8c827b;
  margin-top: 4rpx;
}
.claim-stepper {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.mini-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f6efe8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}
.claim-num {
  min-width: 36rpx;
  text-align: center;
  font-weight: 600;
}
.claim-btn {
  margin-top: 28rpx;
}
.claim-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}
