.sec-title {
  font-weight: 700;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}
.sec-sub {
  font-size: 24rpx;
  color: #7a746e;
  margin-bottom: 24rpx;
}
.slot-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.slot-box {
  border: 2rpx dashed #d6c8be;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  background: #faf6f2;
  color: #6d5a50;
  font-weight: 600;
}
.single-slot {
  margin-top: 20rpx;
}
.skip-merge-box {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee5dd;
}
.scan-btn {
  margin: 20rpx 0;
}
.field-block {
  margin-top: 28rpx;
}
.field-label {
  display: block;
  font-size: 24rpx;
  color: #7a746e;
  margin-bottom: 10rpx;
}
.text-input {
  background: #f7f4f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.submit-btn {
  margin-top: 36rpx;
}
