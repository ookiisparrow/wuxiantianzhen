.lyric-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 28rpx 32rpx 48rpx;
}

.theme-oled {
  background-color: #000000;
  color: #f5f2ed;
}

.theme-warm {
  background-color: #fffdf9;
  color: #2c2623;
}

.watermark-layer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  z-index: 10;
}

.watermark-item {
  transform: rotate(-22deg);
  font-size: 24rpx;
  opacity: 0.09;
  text-align: center;
  letter-spacing: 2rpx;
}

.top-pip-safe-zone {
  max-width: 58%;
  z-index: 20;
}

.part-pill {
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(217, 107, 67, 0.22);
  color: #ff9c73;
  font-weight: 600;
  font-size: 26rpx;
}

.mode-toggle {
  margin-top: 16rpx;
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(160, 150, 140, 0.35);
  font-size: 24rpx;
}

.companion-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  opacity: 0.65;
}

.lower-lyric-stage {
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: auto;
}

.lyric-prev,
.lyric-next {
  text-align: center;
  font-size: 28rpx;
  opacity: 0.45;
  min-height: 44rpx;
}

.lyric-current {
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  text-align: center;
  background: rgba(217, 107, 67, 0.14);
  border: 2rpx solid rgba(217, 107, 67, 0.45);
}

.row-badge {
  font-size: 26rpx;
  color: #ff9c73;
  font-weight: 700;
}

.row-formula {
  font-size: 56rpx;
  font-weight: 800;
  margin: 20rpx 0;
  letter-spacing: 2rpx;
}

.row-stitches {
  font-size: 24rpx;
  opacity: 0.75;
}

.thumb-controls {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.btn-prev {
  flex: 1;
  padding: 32rpx 0;
  border-radius: 28rpx;
  text-align: center;
  background: rgba(140, 130, 120, 0.2);
  font-weight: 600;
}

.btn-next-giant {
  flex: 2.2;
  padding: 32rpx 0;
  border-radius: 28rpx;
  text-align: center;
  background: #d96b43;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}
