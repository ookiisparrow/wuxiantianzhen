.summary-card {
  background: linear-gradient(135deg, #fff5ee 0%, #ffffff 100%);
}
.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #7a746e;
}
.weaver-no {
  font-weight: 700;
  color: #2c2623;
}
.metrics-row {
  display: flex;
  gap: 32rpx;
}
.metric {
  flex: 1;
}
.metric-label {
  display: block;
  font-size: 24rpx;
  color: #7a746e;
}
.metric-val {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #d96b43;
  margin-top: 6rpx;
}
.check-card {
  border: 2rpx solid #f3b59b;
  background: #fff9f6;
}
.check-title {
  font-weight: 700;
  color: #c85228;
  margin-bottom: 8rpx;
}
.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  margin: 24rpx 0;
}
.step-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #f6efe8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}
.step-num {
  font-size: 36rpx;
  font-weight: 700;
}
.pkg-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.pkg-id {
  font-weight: 600;
}
.sku-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  color: #4a423d;
}
.sku-min {
  font-size: 24rpx;
  color: #8c827b;
}
.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}
.empty-card {
  text-align: center;
  color: #8c827b;
  padding: 56rpx 32rpx;
}
